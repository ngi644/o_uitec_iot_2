# このファイルをコピーして .env という名前で保存し，パスワードを書き換えて使います．
#   cp .env.example .env
#   nano .env
#
# .env は GitHub などに公開しないでください（.gitignore に入っています）．
# 講習では，講師が配る紙に書かれたパスワードを使います．

# --- データベース（MariaDB） ---
# 管理者（root）のパスワード
DB_ROOT_PASSWORD=change-me-root
# Node-RED がデータを書き込むときのユーザー（iot_writer）のパスワード
DB_WRITER_PASSWORD=change-me-writer
# Grafana がデータを読むときのユーザー（grafana）のパスワード
DB_READER_PASSWORD=change-me-reader

# --- Grafana ---
# 管理者（admin）のパスワード
GRAFANA_ADMIN_PASSWORD=change-me-admin

# アラートのときに Grafana が呼び出す Node-RED のURL
#   Raspberry Pi で動かすとき: http://host.docker.internal:1880/grafana-alert （そのまま）
#   NAS で動かすとき         : http://<アラート担当の Raspberry Pi のIP>:1880/grafana-alert
ALERT_WEBHOOK_URL=http://host.docker.internal:1880/grafana-alert

# --- 公開するポート番号（ほかのソフトと重なるときだけ変更） ---
MQTT_PORT=1883
DB_PORT=3306
GRAFANA_PORT=3000
ADMINER_PORT=8082
