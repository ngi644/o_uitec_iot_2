    {
      "type": "table",
      "title": "1時間ごとの集計（直近24時間・日本時間）",
      "description": "SQLの GROUP BY で1時間ごとに集計しています（s05 のSQL演習と同じ考え方）",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "iot-mariadb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE_FORMAT(CONVERT_TZ(ts, '+00:00', '+09:00'), '%m/%d %H:00') AS `時刻`,\n  ROUND(AVG(temp), 1)  AS `平均温度`,\n  ROUND(MIN(temp), 1)  AS `最低温度`,\n  ROUND(MAX(temp), 1)  AS `最高温度`,\n  ROUND(AVG(humid), 0) AS `平均湿度`,\n  COUNT(*)             AS `件数`\nFROM sensor_data\nWHERE device = '$device' AND ts >= NOW() - INTERVAL 24 HOUR\nGROUP BY 1\nORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "datasource": {
        "type": "mysql",
        "uid": "iot-mariadb"
      }
