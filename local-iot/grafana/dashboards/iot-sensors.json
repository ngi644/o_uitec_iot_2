            "uid": "iot-mariadb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, $__interval),\n  device AS metric,\n  AVG(temp) AS value\nFROM sensor_data\nWHERE $__timeFilter(ts)\nGROUP BY 1, device\nORDER BY 1"
