  {
    "id": "al_fn",
    "type": "function",
    "z": "alert_tab",
    "name": "アラート → LEDの指示",
    "func": "// Grafana の Webhook 通知の例:\n//   { \"status\": \"firing\",\n//     \"alerts\": [ { \"status\": \"firing\" または \"resolved\",\n//                   \"labels\": { \"alertname\": \"高温（esp01）\", \"device\": \"esp01\" } } ], ... }\n\n// ラベル device が無いアラート（連絡先のテスト送信など）のときに使うデバイスID\nconst DEFAULT_DEVICE = \"esp01\";   // ← 自分のデバイスIDに変える\n\nconst body = msg.payload || {};\nconst alerts = Array.isArray(body.alerts) && body.alerts.length > 0\n    ? body.alerts\n    : [{ status: body.status, labels: body.commonLabels || {} }];\n\n// 1つの通知に複数のアラートが入っていることがあるので，1つずつLEDの指示にする\nconst toLed = alerts.map(a => {\n    const labels = a.labels || {};\n    // アラートのラベル device で，どのESP32のLEDかを決める\n    const device = labels.device || DEFAULT_DEVICE;\n    // 発生中(firing)なら点滅(3)，解決(resolved)なら消灯(2)\n    const led = (a.status === \"firing\") ? 3 : 2;\n    return { topic: `iot/${device}/led`, payload: { status: led }, alertname: labels.alertname };\n});\n\nnode.status({ fill: body.status === \"firing\" ? \"red\" : \"green\", shape: \"dot\",\n              text: `${body.status} (${toLed.length}件)` });\n\n// 2つ目の出力：Grafana に「受け取った」と応答する\nconst toGrafana = { payload: \"ok\", statusCode: 200, req: msg.req, res: msg.res };\nreturn [toLed, toGrafana];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [
      [
        "al_mqtt_out",
        "al_dbg"
      ],
      [
        "al_http_res"
      ]
    ]
  },
